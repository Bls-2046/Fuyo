<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- INFO 级别的输出 -->
    <appender name="INFO_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%highlight(%boldCyan(%d{YYYY-MM-dd HH:mm:ss})) [ %highlight(%boldMagenta(%thread)) ] %highlight(%boldGreen(%-5level))-> %logger{50} - %highlight(%green(%msg%n))</pattern>
        </encoder>
    </appender>

    <!-- WARN 级别的输出 -->
    <appender name="WARN_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%highlight(%boldCyan(%d{YYYY-MM-dd HH:mm:ss})) [ %highlight(%boldMagenta(%thread)) ] %highlight(%boldYellow(%-5level)) -> %logger{50} - %highlight(%yellow(%msg%n))</pattern>
        </encoder>
    </appender>

    <!-- ERROR 级别的输出 -->
    <appender name="ERROR_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%highlight(%boldCyan(%d{YYYY-MM-dd HH:mm:ss})) [ %highlight(%boldMagenta(%thread)) ] %highlight(%boldRed(%-5level)) -> %logger{50} - %highlight(%red(%msg%n))</pattern>
        </encoder>
    </appender>

    <!-- 为 com.github.fuyo 配置日志 -->
    <logger name="com.github.fuyo" level="info" additivity="false">
        <appender-ref ref="INFO_APPENDER" />
        <appender-ref ref="WARN_APPENDER" />
        <appender-ref ref="ERROR_APPENDER" />
    </logger>

    <!-- 根日志配置 -->
    <root level="info">
        <!-- 移除 appender-ref -->
    </root>
</configuration>